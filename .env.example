APP_NAME="POSTIX AI"
APP_ENV=local
APP_KEY=base64:UfiOpxbwoI4FBeDaVrbd5eo8Y+vk3n6NjvhI7HbY3VM=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=postix
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

TELESCOPE_ENABLED=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Account that runs the driver-check listener.
TELEGRAM_DRIVER_CHECK_ACCOUNT_ID=

# Groups to watch, comma separated. Optional: leave it empty and add the
# chats from the panel instead (Driver check -> Chats). These values are
# only imported once, on the first listener start after they are set.
TELEGRAM_DRIVER_CHECK_CHAT_LINKS=

# Chat that receives "no resolver accounts left" warnings.
TELEGRAM_DRIVER_CHECK_NOTIFICATION_CHAT_ID=

# Bot that posts the confirm / recheck buttons under each driver check
# report. Add it to every watched group. Leave the token empty to run
# without buttons.
#
# The webhook is owned by the gateway project, not this one: it forwards
# the updates to POST /api/telegram/webhook here, with the secret below
# as X-Telegram-Bot-Api-Secret-Token or "Authorization: Bearer ...".
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_SECRET=

# The developer's read-only report of the group invites:
# GET /api/telegram/report/group-invites with "Authorization: Bearer ...".
# At least 32 characters (php -r "echo bin2hex(random_bytes(32));");
# empty - the address answers 404.
TELEGRAM_REPORT_TOKEN=

# The developer's read-only chat reader (GET /api/telegram/reader/...): it opens the
# content of chats, so it has its own token, 32+ characters; empty - 404.
TELEGRAM_READER_TOKEN=

MADLINE_DEVICE_MODEL="Postix Ai"
# MADLINE_SYSTEM_VERSION='PHP 8.3 / Ubuntu 22.04.5 LTS'
# MADLINE_APP_VERSION=Telegram Panel v1.2
APP_LOCALE=uz
LOG_LEVEL=info

# The CRM's API: a penalty in "Актуальный" is looked up here, and one
# whose request already has a carrier price goes to the request's sales
# manager. The URL without "/v1"; login is POST {CRM_API_URL}/v1/login.
CRM_API_URL=https://crm.zanjeer.uz/api
CRM_API_EMAIL=
CRM_API_PASSWORD=

# WAREHOUSE_API_URL=https://warehouse.izisol.uz/public/api/
# WAREHOUSE_API_LOGIN=
# WAREHOUSE_API_PASSWORD=

PHP_BINARY=php
# PHP_BINARY=/opt/php83/bin/php